<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OsrsWorldPing.Desktop">
  <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
  <!-- The ICO is for Windows shell resources. Use vectors inside WPF to avoid
       selecting its smallest bitmap frame and scaling a 16px logo up. -->
  <DrawingImage x:Key="AppMark">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <DrawingGroup.Children>
          <GeometryDrawing Geometry="M64,8 L192,8 Q248,8 248,64 L248,192 Q248,248 192,248 L64,248 Q8,248 8,192 L8,64 Q8,8 64,8 Z">
            <GeometryDrawing.Brush>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#332D25"/>
                <GradientStop Offset="1" Color="#101518"/>
              </LinearGradientBrush>
            </GeometryDrawing.Brush>
            <GeometryDrawing.Pen>
              <Pen Brush="#B38E52" Thickness="6"/>
            </GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="M128,31 L207,77 L207,179 L128,225 L49,179 L49,77 Z">
            <GeometryDrawing.Pen>
              <Pen Brush="#C49B55" Thickness="5"/>
            </GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="M128,48 L144,106 L198,128 L144,145 L128,207 L111,145 L58,128 L111,106 Z">
            <GeometryDrawing.Brush>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0.8,1">
                <GradientStop Color="#FFE2A0"/>
                <GradientStop Offset="0.5" Color="#C49B55"/>
                <GradientStop Offset="1" Color="#73502C"/>
              </LinearGradientBrush>
            </GeometryDrawing.Brush>
          </GeometryDrawing>
          <GeometryDrawing Brush="#131C1B">
            <GeometryDrawing.Geometry>
              <EllipseGeometry Center="128,128" RadiusX="22" RadiusY="22"/>
            </GeometryDrawing.Geometry>
            <GeometryDrawing.Pen>
              <Pen Brush="#FFE2A0" Thickness="4"/>
            </GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Brush="#91CEAB">
            <GeometryDrawing.Geometry>
              <EllipseGeometry Center="128,128" RadiusX="8" RadiusY="8"/>
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
        </DrawingGroup.Children>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
  <SolidColorBrush x:Key="Ink" Color="#EFE8DA"/>
  <SolidColorBrush x:Key="Muted" Color="#B2ADA4"/>
  <SolidColorBrush x:Key="Gold" Color="#D8B575"/>
  <SolidColorBrush x:Key="Line" Color="#60513B"/>
  <SolidColorBrush x:Key="Surface" Color="#EE202426"/>
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="FontSize" Value="14"/>
  </Style>
  <Style x:Key="Label" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Margin" Value="0,0,0,6"/>
  </Style>
  <Style x:Key="Heading" TargetType="TextBlock">
    <Setter Property="FontSize" Value="26"/>
    <Setter Property="FontFamily" Value="Georgia"/>
    <Setter Property="Foreground" Value="{StaticResource Gold}"/>
    <Setter Property="Margin" Value="0,0,0,16"/>
  </Style>
  <Style x:Key="FocusRing" TargetType="Control">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderThickness="2" CornerRadius="4" BorderBrush="{StaticResource Gold}" Margin="-3"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="Background" Value="#383128"/>
    <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="18,11"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource Gold}"/>
              <Setter TargetName="Plate" Property="Opacity" Value="0.85"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Plate" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="12"/>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="Box" Width="20" Height="20" Background="#202628" BorderBrush="#9A8B70" BorderThickness="1" CornerRadius="3" Margin="0,0,9,0">
              <Path x:Name="Tick" Data="M3,9 L7,13 L15,4" Stroke="{StaticResource Gold}" StrokeThickness="2" Visibility="Collapsed"/>
            </Border>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True">
              <ContentPresenter.ContentTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                </DataTemplate>
              </ContentPresenter.ContentTemplate>
            </ContentPresenter>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Gold}"/>
              <Setter TargetName="Box" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="Background" Value="#202628"/>
    <Setter Property="CaretBrush" Value="{StaticResource Gold}"/>
    <Setter Property="SelectionBrush" Value="#7D653C"/>
    <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
  </Style>
  <Style TargetType="TabControl">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0,24,0,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid KeyboardNavigation.TabNavigation="Local">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <WrapPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" Margin="{TemplateBinding Padding}" ContentSource="SelectedContent" KeyboardNavigation.TabIndex="2"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    <Setter Property="Padding" Value="22,12"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Tab" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent">
            <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Gold}"/>
              <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource Gold}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Hyperlink">
    <Setter Property="Foreground" Value="{StaticResource Gold}"/>
  </Style>
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="Background" Value="#292C2B"/>
    <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    <Setter Property="Padding" Value="12"/>
    <Setter Property="MaxWidth" Value="420"/>
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DangerText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsDangerous}" Value="True">
        <Setter Property="Foreground" Value="#FF9690"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="MemberStar" TargetType="Path">
    <Setter Property="Data" Value="M10,0 L13,6.5 L20,7.5 L15,12.5 L16,20 L10,16.5 L4,20 L5,12.5 L0,7.5 L7,6.5 Z"/>
    <Setter Property="Width" Value="15"/>
    <Setter Property="Height" Value="15"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="Stroke" Value="{StaticResource Gold}"/>
    <Setter Property="Fill" Value="Transparent"/>
    <Setter Property="StrokeThickness" Value="1.5"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsMembers}" Value="True">
        <Setter Property="Fill" Value="{StaticResource Gold}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding HasWorld}" Value="False">
        <Setter Property="Visibility" Value="Hidden"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="WorldToggle" TargetType="ToggleButton">
    <Setter Property="Width" Value="26"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="#92948C"/>
    <Setter Property="Opacity" Value="0.6"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Setter Property="local:Motion.PopOnCheck" Value="True"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Opacity" Value="1"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="Opacity" Value="1"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="FavoriteToggle" TargetType="ToggleButton" BasedOn="{StaticResource WorldToggle}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="Transparent" CornerRadius="4">
            <Path Width="14" Height="14" Stretch="Uniform" Fill="{TemplateBinding Foreground}" Data="M12,21 C9,18 1,13 1,7 C1,0 9,-1 12,5 C15,-1 23,0 23,7 C23,13 15,18 12,21 Z"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Foreground" Value="#F27D8C"/>
        <Setter Property="Opacity" Value="1"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="#F3ACB5"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.35"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="TrackingToggle" TargetType="ToggleButton" BasedOn="{StaticResource WorldToggle}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="Transparent" CornerRadius="4">
            <Path Width="14" Height="16" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,2 L12,12 M6,5 A9,9 0 1 0 18,5"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Foreground" Value="#A9DFBE"/>
        <Setter Property="Opacity" Value="1"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="#C9E9D5"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.5"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ScrollPage" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Handle" Background="#84765E" CornerRadius="3" Margin="2,0"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Handle" Property="Background" Value="#D8B575"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Handle" Property="Background" Value="#E5C995"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/>
    <Setter Property="MinHeight" Value="20"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="#32121B20">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb MinHeight="24"/>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <DataTemplate x:Key="WorldCard" DataType="{x:Type local:WorldCardModel}">
    <local:WorldTile/>
  </DataTemplate>
  <DataTemplate x:Key="TrackingCard" DataType="{x:Type local:WorldCardModel}">
    <local:WorldTile Editable="True"/>
  </DataTemplate>
</ResourceDictionary>
