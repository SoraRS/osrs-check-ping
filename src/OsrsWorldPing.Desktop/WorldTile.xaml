<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OsrsWorldPing.Desktop" x:Class="OsrsWorldPing.Desktop.WorldTile" Height="44" Focusable="False">
  <local:WorldCardSurface x:Name="Surface" Margin="2,1" Padding="6,2" CornerRadius="5" BorderThickness="0" Focusable="False" ToolTip="{Binding ReadingDetails}" AutomationProperties.Name="{Binding AccessibleDescription}">
    <local:WorldCardSurface.Style><Style TargetType="local:WorldCardSurface"><Setter Property="Background" Value="Transparent"/><Setter Property="Opacity" Value="1"/><Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#38121B20"/></Trigger>
      <DataTrigger Binding="{Binding IsTracked}" Value="False"><Setter Property="Opacity" Value="0.46"/></DataTrigger>
      <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsTracked}" Value="False"/><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Opacity" Value="0.86"/></MultiDataTrigger>
    </Style.Triggers></Style></local:WorldCardSurface.Style>
    <Grid><Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="16"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ToggleButton x:Name="FavoriteToggle" Style="{StaticResource FavoriteToggle}" IsChecked="{Binding IsFavorite, Mode=OneWay}" Command="{Binding ToggleFavorite}" ToolTip="{Binding FavoriteHint}" AutomationProperties.Name="{Binding WorldLabel, StringFormat=Favorite {0}}" Margin="-4,-2,4,-2"/>
        <TextBlock x:Name="WorldNumber" Text="{Binding Id}" Style="{StaticResource DangerText}" FontSize="16" FontWeight="SemiBold" Margin="0,0,9,0" ToolTip="{Binding DangerReason}"/>
        <TextBlock x:Name="LatencyValue" Text="{Binding Latency}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#C7AB76"/><Style.Triggers><DataTrigger Binding="{Binding IsGood}" Value="True"><Setter Property="Foreground" Value="#A9DFBE"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </StackPanel>
      <DockPanel Grid.Row="1" LastChildFill="True">
        <Grid Width="18" Height="16" Margin="0,0,5,0">
          <local:ActivityGlyph Kind="{Binding ActivityIcon}" Width="14" Height="14" Visibility="{Binding HasActivityFallback, Converter={StaticResource VisibleWhenTrue}}"/>
          <Image x:Name="ActivitySprite" Source="{Binding ActivitySprite}" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform" Visibility="{Binding HasActivitySprite, Converter={StaticResource VisibleWhenTrue}}"/>
          <local:FlagGlyph x:Name="RegionFlag" Country="{Binding CountryCode}" Width="18" Height="12" ToolTip="{Binding Region}"><local:FlagGlyph.Style><Style TargetType="local:FlagGlyph"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasActivity}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding HasWorld}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></local:FlagGlyph.Style></local:FlagGlyph>
        </Grid>
        <TextBlock x:Name="ActivityText" Text="{Binding ActivityLabel}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Activity}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource ActivityInk}"/><Style.Triggers><DataTrigger Binding="{Binding IsDangerous}" Value="True"><Setter Property="Foreground" Value="#FF9690"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </DockPanel>
    </Grid>
  </local:WorldCardSurface>
</UserControl>
