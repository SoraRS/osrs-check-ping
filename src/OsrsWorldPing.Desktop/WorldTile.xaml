<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OsrsWorldPing.Desktop" x:Class="OsrsWorldPing.Desktop.WorldTile" Height="54" Focusable="False">
  <local:WorldCardSurface x:Name="Surface" Margin="3,2" Padding="8,5" CornerRadius="5" BorderThickness="0" Focusable="False" ToolTip="{Binding ReadingDetails}" AutomationProperties.Name="{Binding AccessibleDescription}">
    <local:WorldCardSurface.Style>
      <Style TargetType="local:WorldCardSurface">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Opacity" Value="1"/>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#38121B20"/></Trigger>
          <DataTrigger Binding="{Binding IsTracked}" Value="False"><Setter Property="Opacity" Value="0.46"/></DataTrigger>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions><Condition Binding="{Binding IsTracked}" Value="False"/><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/></MultiDataTrigger.Conditions>
            <Setter Property="Opacity" Value="0.86"/>
          </MultiDataTrigger>
        </Style.Triggers>
      </Style>
    </local:WorldCardSurface.Style>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="18"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ToggleButton x:Name="FavoriteToggle" Style="{StaticResource FavoriteToggle}" IsChecked="{Binding IsFavorite, Mode=OneWay}" Command="{Binding ToggleFavorite}" ToolTip="{Binding FavoriteHint}" AutomationProperties.Name="{Binding WorldLabel, StringFormat=Favorite {0}}" Margin="-4,-1,4,-1"/>
        <Path x:Name="MembershipStar" Style="{StaticResource MemberStar}" Width="12" Height="12" Margin="0,0,6,0" ToolTip="{Binding Membership}"/>
        <TextBlock x:Name="WorldNumber" Text="{Binding Id}" Style="{StaticResource DangerText}" FontSize="16" FontWeight="SemiBold" Margin="0,0,9,0" ToolTip="{Binding DangerReason}"/>
        <TextBlock x:Name="LatencyValue" Text="{Binding Latency}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E3BD80"/><Style.Triggers><DataTrigger Binding="{Binding IsGood}" Value="True"><Setter Property="Foreground" Value="#A9DFBE"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <local:FlagGlyph x:Name="RegionFlag" Country="{Binding CountryCode}" Width="22" Height="15" ToolTip="{Binding Region}"/>
      </StackPanel>
      <DockPanel Grid.Row="1" LastChildFill="True">
        <TextBlock DockPanel.Dock="Right" Text="Scan result" FontSize="9" Foreground="#B6B1A5" VerticalAlignment="Center" Margin="5,0,0,0" Visibility="{Binding ShowScanResult, Converter={StaticResource VisibleWhenTrue}}"/>
        <Grid Width="18" Height="18" Margin="0,0,5,0">
          <local:ActivityGlyph Kind="{Binding ActivityIcon}" Width="14" Height="14" Visibility="{Binding HasActivityFallback, Converter={StaticResource VisibleWhenTrue}}"/>
          <Image x:Name="ActivitySprite" Source="{Binding ActivitySprite}" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform" Visibility="{Binding HasActivitySprite, Converter={StaticResource VisibleWhenTrue}}"/>
        </Grid>
        <TextBlock x:Name="ActivityText" Text="{Binding Activity}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Activity}">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#DDD6C6"/><Style.Triggers>
            <DataTrigger Binding="{Binding IsMembers}" Value="False"><Setter Property="Foreground" Value="#C4CCD6"/></DataTrigger>
            <DataTrigger Binding="{Binding IsDangerous}" Value="True"><Setter Property="Foreground" Value="#FF9690"/></DataTrigger>
          </Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
      </DockPanel>
    </Grid>
  </local:WorldCardSurface>
</UserControl>
