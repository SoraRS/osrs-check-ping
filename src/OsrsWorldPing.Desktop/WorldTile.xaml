<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OsrsWorldPing.Desktop" x:Class="OsrsWorldPing.Desktop.WorldTile" Height="68" Focusable="False">
  <local:WorldCardSurface x:Name="Surface" Margin="4" Padding="10,7" CornerRadius="6" BorderThickness="1" Focusable="False" ToolTip="{Binding ReadingDetails}" AutomationProperties.Name="{Binding AccessibleDescription}">
    <local:WorldCardSurface.Style>
      <Style TargetType="local:WorldCardSurface">
        <Setter Property="Background" Value="#64121B20"/>
        <Setter Property="BorderBrush" Value="#505F594B"/>
        <Setter Property="Opacity" Value="1"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsMembers}" Value="True">
            <Setter Property="BorderBrush" Value="#707E6947"/>
          </DataTrigger>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="#95121B20"/>
            <Setter Property="BorderBrush" Value="#D8B575"/>
          </Trigger>
          <DataTrigger Binding="{Binding HasWorld}" Value="False">
            <Setter Property="Opacity" Value="0.48"/>
          </DataTrigger>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Binding="{Binding Editable, RelativeSource={RelativeSource AncestorType={x:Type local:WorldTile}}}" Value="True"/>
              <Condition Binding="{Binding IsTracked}" Value="False"/>
            </MultiDataTrigger.Conditions>
            <Setter Property="Opacity" Value="0.46"/>
          </MultiDataTrigger>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Binding="{Binding Editable, RelativeSource={RelativeSource AncestorType={x:Type local:WorldTile}}}" Value="True"/>
              <Condition Binding="{Binding IsTracked}" Value="False"/>
              <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
            </MultiDataTrigger.Conditions>
            <Setter Property="Opacity" Value="0.86"/>
          </MultiDataTrigger>
        </Style.Triggers>
      </Style>
    </local:WorldCardSurface.Style>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="23"/>
        <RowDefinition Height="20"/>
      </Grid.RowDefinitions>
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,-2,-5,-2">
          <ToggleButton x:Name="TrackingToggle" Style="{StaticResource TrackingToggle}" IsChecked="{Binding IsTracked, Mode=OneWay}" IsEnabled="{Binding CanTrack}" Command="{Binding ToggleTracking}" ToolTip="{Binding TrackingHint}" AutomationProperties.Name="{Binding WorldLabel, StringFormat=Track {0}}" Visibility="{Binding Editable, RelativeSource={RelativeSource AncestorType={x:Type local:WorldTile}}, Converter={StaticResource VisibleWhenTrue}}"/>
          <ToggleButton x:Name="FavoriteToggle" Style="{StaticResource FavoriteToggle}" IsChecked="{Binding IsFavorite, Mode=OneWay}" Command="{Binding ToggleFavorite}" ToolTip="{Binding FavoriteHint}" AutomationProperties.Name="{Binding WorldLabel, StringFormat=Favorite {0}}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <local:FlagGlyph Country="{Binding CountryCode}" Width="22" Height="15" Margin="0,0,6,0" ToolTip="{Binding Region}"/>
          <Path Style="{StaticResource MemberStar}" Width="12" Height="12" Margin="0,0,6,0" ToolTip="{Binding Membership}"/>
          <TextBlock x:Name="WorldNumber" Text="{Binding Id}" Style="{StaticResource DangerText}" FontSize="16" FontWeight="SemiBold" Margin="0,0,9,0" ToolTip="{Binding DangerReason}"/>
          <TextBlock x:Name="LatencyValue" Text="{Binding Latency}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#E3BD80"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsGood}" Value="True">
                    <Setter Property="Foreground" Value="#A9DFBE"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <local:SignalGlyph x:Name="ConnectionBars" Level="{Binding Signal}" Good="{Binding IsGood}" Width="22" Height="14" VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>
      <DockPanel Grid.Row="1" LastChildFill="True" Margin="0,2,0,0">
        <TextBlock DockPanel.Dock="Right" Text="Scan result" FontSize="9" Foreground="#B6B1A5" VerticalAlignment="Center" Margin="5,0,0,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Editable, RelativeSource={RelativeSource AncestorType={x:Type local:WorldTile}}}" Value="True"/>
                    <Condition Binding="{Binding IsTracked}" Value="False"/>
                    <Condition Binding="{Binding HasWorld}" Value="True"/>
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <Grid Width="20" Height="20" Margin="0,0,5,0">
          <local:ActivityGlyph Kind="{Binding ActivityIcon}" Width="15" Height="15">
            <local:ActivityGlyph.Style>
              <Style TargetType="local:ActivityGlyph">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasActivitySprite}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </local:ActivityGlyph.Style>
          </local:ActivityGlyph>
          <Image x:Name="ActivitySprite" Source="{Binding ActivitySprite}" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform" Visibility="{Binding HasActivitySprite, Converter={StaticResource VisibleWhenTrue}}"/>
        </Grid>
        <TextBlock Text="{Binding Activity}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Activity}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="#DDD6C6"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsDangerous}" Value="True">
                  <Setter Property="Foreground" Value="#FF9690"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </DockPanel>
    </Grid>
  </local:WorldCardSurface>
</UserControl>
