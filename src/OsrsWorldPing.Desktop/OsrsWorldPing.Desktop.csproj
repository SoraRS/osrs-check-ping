<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF owns DPI awareness through the manifest; WinForms supplies only the tray icon/menu. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>OsrsWorldPing</AssemblyName>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.3.0</Version>
    <Description>Connection latency for Old School RuneScape worlds</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../OsrsWorldPing.Core/OsrsWorldPing.Core.csproj" />
    <Resource Include="Assets/**/*.png;Assets/*.ico;Assets/Osrs/LICENSE-RuneLite.txt;Assets/Osrs/SOURCES.md" />
  </ItemGroup>
</Project>
